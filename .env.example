# Production origin used for canonical URLs, Open Graph, sitemap, and robots.
SITE_URL=

# Instagram API with Instagram Login. Use an Instagram professional account token.
INSTAGRAM_ACCESS_TOKEN=
# Optional Instagram-scoped account ID. Leave empty to use /me.
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v26.0
INSTAGRAM_REVALIDATE_SECONDS=21600
SHOW_INSTAGRAM_UPDATED_AT=true

# Contact form delivery via Resend. CONTACT_FROM_EMAIL must use a verified domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Optional override. Defaults to the email in site-config.ts.
CONTACT_TO_EMAIL=
